# ---- App ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Password for /dashboard (leave empty in dev to skip login)
DASHBOARD_PASSWORD=
# Secret for cron / sync endpoints (Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=change-me

# ---- Database ----
# None needed — data is stored locally in data/db.json

# ---- Anthropic (Claude) — optional; without it AI uses built-in templates ----
ANTHROPIC_API_KEY=

# ---- Google (Gmail + Calendar, one OAuth app) — optional; without it emails/bookings stay local ----
# Console: https://console.cloud.google.com -> APIs & Services -> Credentials -> OAuth client (Web)
# Redirect URI: {NEXT_PUBLIC_APP_URL}/api/auth/google/callback
# Enable APIs: Gmail API, Google Calendar API
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_ID=primary
